# --- AI extraction (optional but recommended) ---------------------------
# Without a key, Plimsoll still works: CSV/XLSX/JSON and digital PDFs are
# parsed by the built-in layout parser. Scanned PDFs and photos need Claude.
ANTHROPIC_API_KEY=
# Model used for extraction and the resolution advisor.
PLIMSOLL_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thoroughness vs. cost per document)
PLIMSOLL_EXTRACTION_EFFORT=medium

# --- App ------------------------------------------------------------------
# Used to sign session cookies. Generate with: openssl rand -hex 32
PLIMSOLL_SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite database and uploaded files live.
PLIMSOLL_DATA_DIR=./data
PLIMSOLL_PUBLIC_URL=http://localhost:3000

# --- Billing (optional) ---------------------------------------------------
# Leave blank to run billing in demo mode (plan changes apply instantly).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PACK=
